VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Google Drive OAuth credentials. Keep the secret/token out of Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Exact callback URL registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN.vercel.app/api/drive/oauth-callback
# Optional: a Drive folder ID. Leave blank to store files in the Drive root.
GOOGLE_DRIVE_FOLDER_ID=
